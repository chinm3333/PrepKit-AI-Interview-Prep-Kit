# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/interview_prep_kit

# Auth
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7

# LLM | set LLM_PROVIDER=gemini when Groq TPM is exhausted (evaluate burns many tokens)
# Groq: https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# Current AI Studio ids — free tier has per-model RPM; 3.5-flash is a good default
GEMINI_MODEL=gemini-3.5-flash
# Pause between evaluate cases (ms). Raise if you still hit 429s.
EVALUATE_PAUSE_MS=12000

# API
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Retrieval
FETCH_TIMEOUT_MS=15000
MAX_PAGE_BYTES=750000
MAX_PAGES_PER_SITE=12
ALLOW_PRIVATE_URLS=true

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
